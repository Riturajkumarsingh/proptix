# Vercel & Neon Production Environment Variables

# Node Environment
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Neon PostgreSQL Database URL
# Go to neon.tech, create a database, and paste the connection string here.
# Example: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://YOUR_NEON_DB_URL_HERE"

# Authentication Secrets
# Generate a strong random string (e.g., using `openssl rand -hex 64`)
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Frontend URL (for CORS)
# This should be your deployed Vercel frontend URL
FRONTEND_URL="https://your-frontend-project.vercel.app"
